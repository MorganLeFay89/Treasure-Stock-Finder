// **************************************************************************
// JsonSerializableGenerator
// **************************************************************************

_$StockImpl _$$StockImplFromJson(Map<String, dynamic> json) => _$StockImpl(
      stockCode: json['stockCode'] as String,
      stockName: json['stockName'] as String,
      market: json['market'] as String,
      industry: json['industry'] as String,
      revenueGrowthRate: (json['revenueGrowthRate'] as num).toDouble(),
      operatingProfitGrowthRate:
          (json['operatingProfitGrowthRate'] as num).toDouble(),
      profitMargin: (json['profitMargin'] as num).toDouble(),
      forecastPER: (json['forecastPER'] as num).toDouble(),
      pbr: (json['pbr'] as num).toDouble(),
      forecastDividendYield: (json['forecastDividendYield'] as num).toDouble(),
      roe: (json['roe'] as num).toDouble(),
      roa: (json['roa'] as num).toDouble(),
      equityRatio: (json['equityRatio'] as num).toDouble(),
      marketCap: (json['marketCap'] as num).toInt(),
      aiScore: (json['aiScore'] as num?)?.toDouble(),
    );

Map<String, dynamic> _$$StockImplToJson(_$StockImpl instance) =>
    <String, dynamic>{
      'stockCode': instance.stockCode,
      'stockName': instance.stockName,
      'market': instance.market,
      'industry': instance.industry,
      'revenueGrowthRate': instance.revenueGrowthRate,
      'operatingProfitGrowthRate': instance.operatingProfitGrowthRate,
      'profitMargin': instance.profitMargin,
      'forecastPER': instance.forecastPER,
      'pbr': instance.pbr,
      'forecastDividendYield': instance.forecastDividendYield,
      'roe': instance.roe,
      'roa': instance.roa,
      'equityRatio': instance.equityRatio,
      'marketCap': instance.marketCap,
      'aiScore': instance.aiScore,
    };
